{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "jsxSingleQuote": false,
  "objectWrap": "collapse",
  "printWidth": 80,
  "quoteProps": "as-needed",
  "singleAttributePerLine": true,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": true,
  "sortPackageJson": true
}
